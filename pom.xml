<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>

	<groupId>es.cic.tessa</groupId>
	<artifactId>tessa-support</artifactId>
	<version>2.7.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>TESSA support project</name>
	<description>TESSA support project</description>

	<modules>
		<module>tessa-core-model</module>
		<module>tessa-excel-model</module>
		<module>tessa-lookup-model</module>
		<module>tessa-common</module>
		<module>tessa-client</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.target>21</maven.compiler.target>
		<maven.compiler.source>21</maven.compiler.source>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<configuration>
					<!-- Salta javadoc siempre; ${arguments} permite añadir flags por CLI (-Darguments=...) -->
					<arguments>-Dmaven.javadoc.skip=true ${arguments}</arguments>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.awspring.cloud</groupId>
				<artifactId>spring-cloud-aws-dependencies</artifactId>
				<version>4.0.1</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<repositories>
		<repository>
			<id>tessa-maven-public</id>
			<name>Repositorio Assets Management - Publico</name>
			<url>https://ic-atenea.corp.cic.es/repository/cic-tessa-maven-group/</url>
		</repository>
	</repositories>

	<distributionManagement>
		<snapshotRepository>
			<id>maven-snapshot</id>
			<name>Repositorio Assets Management - Snapshots</name>
			<url>
				https://ic-atenea.corp.cic.es/repository/cic-tessa-maven-snapshots/</url>
		</snapshotRepository>
		<repository>
			<id>maven-release</id>
			<name>Repositorio Assets Management - Releases</name>
			<url>
				https://ic-atenea.corp.cic.es/repository/cic-tessa-maven-releases/</url>
		</repository>
	</distributionManagement>

	<pluginRepositories>
		<pluginRepository>
			<id>tessa-maven-public</id>
			<name>RepositorioCIC - Publico</name>
			<url>https://ic-atenea.corp.cic.es/repository/cic-tessa-maven-group/</url>
			<layout>default</layout>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<releases>
				<updatePolicy>never</updatePolicy>
			</releases>
		</pluginRepository>
	</pluginRepositories>

	<scm>
		<connection>
			scm:git:https://gitlab.corp.cic.es/CIC/tessa/tessa-support.git</connection>
		<developerConnection>
			scm:git:https://gitlab.corp.cic.es/CIC/tessa/tessa-support.git</developerConnection>
		<url>https://gitlab.corp.cic.es/CIC/tessa/tessa-support.git</url>
		<tag>tessa-support-2.4.2</tag>
	</scm>

</project>